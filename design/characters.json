{
  "schemaVersion": 1,
  "status": "M1 generated source; art is procedural stylized, not final hand-sculpted art",
  "description": "Single source for original kantor-rpg character appearance. Read by blender/characters/build_characters.py, blender/validate_assets.py, blender/characters/render_sheet.py and tests/py/test_assets.py. Characters are original stylized semi-anime designs; they are not likenesses of real people and do not reuse any third-party character, asset or IP.",
  "units": "m",
  "conventions": {
    "up": "+Z in Blender, +Y in glTF/three.js",
    "forward": "character faces Blender -Y, which the glTF exporter writes as +Z (three.js +Z)",
    "origin": "feet center on the floor (Z=0)",
    "leftSide": "character left is Blender +X (bone suffix _L)"
  },
  "budgets": {
    "npcTrianglesLOD0": 15000,
    "playerTrianglesLOD0": 25000,
    "glbBytesTarget": 1500000,
    "heightTolerance": 0.05,
    "previewBytesMax": 400000,
    "npcTrianglesLOD1": 5000,
    "visiblePrimitivesLOD0": 2,
    "note": "Targets from PRD section 6; measured values live in design/asset-registry.json and the latest validator report (docs/evidence/HARDENING/blender-characters-validate.json). npcTrianglesLOD1 is the PRD NPC LOD1 budget, applied to the lod1 node of all seven characters including the CEO. visiblePrimitivesLOD0 counts body + one hair; hand-held prop_* nodes are separate toggleable nodes and add one primitive where present"
  },
  "rig": {
    "skeleton": "shared",
    "bones": [
      "root",
      "hips",
      "spine",
      "chest",
      "neck",
      "head",
      "upper_arm_L",
      "forearm_L",
      "hand_L",
      "upper_arm_R",
      "forearm_R",
      "hand_R",
      "thigh_L",
      "shin_L",
      "foot_L",
      "thigh_R",
      "shin_R",
      "foot_R"
    ],
    "boneNamingNote": "Underscore side suffix instead of .L because three.js PropertyBinding strips dots from node names",
    "fps": 30,
    "seatHeightM": 0.45,
    "seatNote": "sit/type/game place the pelvis on a seat surface 0.45 m above the root (root stays on the floor). With semi-anime leg length the feet hang a little above the floor on a 0.45 m seat; this is an intentional stylization, see blender/README.md"
  },
  "locomotion": {
    "walk": {
      "cycleS": 1.0,
      "requestedSpeedMps": 1.4,
      "nativeSpeedMps": "per character, about 0.80 to 0.87; measured value in design/asset-registry.json locomotion and GLB rig extras kantor_walk_native_speed_mps",
      "inPlace": true
    },
    "run": {
      "cycleS": 0.6,
      "nativeSpeedMps": "per character, about 2.27 to 2.50; see kantor_run_native_speed_mps",
      "inPlace": true
    },
    "note": "Clips animate in place. The planted foot travels at the native speed (validated slip under 5 percent), so runtime should move the root at nativeSpeed * timeScale. The requested 1.4 m/s walk with a 1.0 s cycle needs a 1.4 m stride, which these semi-anime legs (hip height about 0.6 m) cannot reach without foot sliding; to move at 1.4 m/s play walk with timeScale = 1.4 / nativeSpeed (about 1.7), or use a slower walk speed."
  },
  "animations": {
    "idle": {
      "durationS": 2.0,
      "loop": true
    },
    "walk": {
      "durationS": 1.0,
      "loop": true
    },
    "run": {
      "durationS": 0.6,
      "loop": true
    },
    "wave": {
      "durationS": 1.6,
      "loop": false
    },
    "talk": {
      "durationS": 2.4,
      "loop": true
    },
    "sit": {
      "durationS": 2.0,
      "loop": true
    },
    "type": {
      "durationS": 1.0,
      "loop": true
    },
    "read": {
      "durationS": 2.4,
      "loop": true
    },
    "coffee": {
      "durationS": 3.0,
      "loop": true
    },
    "stretch": {
      "durationS": 3.0,
      "loop": false
    },
    "exercise": {
      "durationS": 0.8,
      "loop": true
    },
    "billiards": {
      "durationS": 2.4,
      "loop": true
    },
    "game": {
      "durationS": 1.6,
      "loop": true
    }
  },
  "hairStyles": {
    "short_tuft": "short cropped cap, five short bangs and one curled crown tuft",
    "swept": "volume swept to the character's right with four long side bangs",
    "spiky_soft": "rounded spikes radiating from the crown, soft tips",
    "bob": "jaw-length rounded bob with a curled hem and straight bangs",
    "bun": "short cap with a round bun at the back of the crown and side locks",
    "cap": "work cap (no logo) with a short brim over short hair",
    "side_part": "neat side part with a short fringe on one side"
  },
  "materialNames": {
    "required": [
      "skin",
      "eyes",
      "eye_iris",
      "eye_highlight",
      "mouth",
      "blush",
      "hair",
      "outfit_main",
      "outfit_inner",
      "outfit_bottom",
      "outfit_accent",
      "shoes",
      "shoe_sole"
    ],
    "optional": [
      "prop_main",
      "prop_accent",
      "prop_detail"
    ],
    "note": "These are zone names, not materials: every character GLB has one material kantor_atlas and each zone owns one cell of its palette texture (see atlas). Palette keys outfit_* equal zone names, so runtime recolours by repainting those cells in a cloned texture"
  },
  "atlas": {
    "material": "kantor_atlas",
    "sizePx": 32,
    "cellPx": 4,
    "columns": 8,
    "zoneOrder": ["skin", "eyes", "eye_iris", "eye_highlight", "mouth", "blush", "hair", "outfit_main", "outfit_inner", "outfit_bottom", "outfit_accent", "shoes", "shoe_sole", "prop_main", "prop_accent", "prop_detail"],
    "layout": "zone i owns cell [col, row] = [i % columns, i // columns]; row 0 is the top row of the PNG as stored; every face of a zone has its UVs at that cell centre",
    "filter": "nearest",
    "roughness": 0.85,
    "extras": "GLB scene extras and rig node extras carry kantor_atlas = {size, cell, zones: {zone: [col, row]}}"
  },
  "expressions": {
    "names": ["blink", "smile", "talk", "surprised", "frown"],
    "node": "body",
    "note": "Shape keys on body, exported as glTF morph targets in this order (mesh extras targetNames). Deltas only move head-weighted face features (eyes, lashes, brows, mouth); talk opens the mouth for speech. lod1 has no morph targets."
  },
