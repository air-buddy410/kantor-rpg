{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/air-buddy410/kantor-rpg/design/world.schema.json",
 "title": "kantor-rpg world dataset",
 "description": "Single source for CAD, Blender, runtime and ICT. Units metres, origin SW corner of L1, X east, Y north, Z up. Concept data, not construction data.",
 "type": "object",
 "required": ["schemaVersion", "project", "revision", "status", "units", "coordinates", "building", "floors", "rooms", "doors", "verticalLinks", "catalog", "fixtures", "activitySlots", "waypoints", "actors", "ict", "adjacency", "assumptions"],
 "additionalProperties": false,
 "$defs": {
  "id": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$", "maxLength": 40},
  "floorId": {"type": "string", "enum": ["L1", "L2"]},
  "num": {"type": "number", "minimum": -1000, "maximum": 1000},
  "pt": {"type": "array", "items": {"$ref": "#/$defs/num"}, "minItems": 2, "maxItems": 2},
  "poly": {"type": "array", "items": {"$ref": "#/$defs/pt"}, "minItems": 4, "maxItems": 64},
  "size3": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 50}, "minItems": 3, "maxItems": 3},
  "rot": {"type": "number", "enum": [0, 90, 180, 270]},
  "fixture": {
   "type": "object",
   "required": ["id", "floor", "room", "type", "asset", "pos", "rot", "size", "collider"],
   "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "floor": {"$ref": "#/$defs/floorId"}, "room": {"$ref": "#/$defs/id"},
    "type": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "asset": {"$ref": "#/$defs/id"},
    "pos": {"$ref": "#/$defs/pt"}, "rot": {"$ref": "#/$defs/rot"}, "size": {"$ref": "#/$defs/size3"},
    "collider": {"type": "boolean"}, "pairedWith": {"$ref": "#/$defs/id"}, "artwork": {"$ref": "#/$defs/id"},
    "verticalLink": {"$ref": "#/$defs/id"}, "ictRack": {"$ref": "#/$defs/id"}
   }
  }
 },
 "properties": {
  "$schema": {"type": "string"},
  "schemaVersion": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
  "project": {"const": "kantor-rpg"},
  "revision": {"type": "object", "required": ["id", "date", "note"], "properties": {"id": {"type": "string"}, "date": {"type": "string", "format": "date"}, "note": {"type": "string"}}},
  "status": {"type": "string", "pattern": "KONSEP"},
  "units": {"type": "object", "required": ["length", "cadExportUnit", "cadScale", "angle"], "properties": {"length": {"const": "m"}, "cadExportUnit": {"const": "mm"}, "cadScale": {"const": 1000}, "angle": {"const": "deg"}}},
  "coordinates": {"type": "object", "required": ["origin", "axes", "runtimeThree", "blender", "cad", "fixtureFront"]},
  "building": {
   "type": "object", "required": ["id", "footprint", "floorToFloor", "ceilingHeight", "slab", "wall"],
   "properties": {"footprint": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 2, "maxItems": 2},
    "floorToFloor": {"type": "number", "minimum": 2.5, "maximum": 8}, "ceilingHeight": {"type": "number", "minimum": 2.2, "maximum": 6},
    "wall": {"type": "object", "required": ["exterior", "interior"]}}
  },
  "floors": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["id", "name", "level", "elevation", "envelope", "spawn", "safePoint"],
   "properties": {"id": {"$ref": "#/$defs/floorId"}, "envelope": {"$ref": "#/$defs/poly"}, "elevation": {"type": "number"}}}},
  "rooms": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false,
   "required": ["id", "floor", "name", "category", "access", "noise", "function", "polygon", "finish", "ict", "status", "assumptions", "occupantLoadKey"],
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "floor": {"$ref": "#/$defs/floorId"}, "name": {"type": "string", "minLength": 2, "maxLength": 60},
    "category": {"enum": ["public", "work", "quiet", "recreation", "wet", "service", "circulation", "shaft", "restricted", "outdoor"]},
    "access": {"enum": ["public", "staff", "restricted"]}, "noise": {"enum": ["quiet", "moderate", "loud"]},
    "function": {"type": "string"}, "polygon": {"$ref": "#/$defs/poly"},
    "occupantLoadKey": {"type": ["string", "null"]},
    "finish": {"type": "object", "required": ["floor", "wall", "ceiling"]},
    "ict": {"type": "array", "items": {"type": "string"}}, "status": {"type": "string"},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/id"}}
   }}},
  "doors": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["id", "floor", "rooms", "center", "width", "type", "access", "exit", "wallAxis"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "floor": {"$ref": "#/$defs/floorId"},
    "rooms": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 2, "maxItems": 2},
    "center": {"$ref": "#/$defs/pt"}, "width": {"type": "number", "minimum": 0.5, "maximum": 4},
    "type": {"enum": ["single", "double", "opening", "sliding", "hatch"]}, "access": {"enum": ["public", "staff", "restricted"]},
    "exit": {"type": "boolean"}, "wallAxis": {"enum": ["x", "y"]}}}},
  "verticalLinks": {"type": "array", "items": {"type": "object", "required": ["id", "type", "ends", "prompt", "status"]}},
  "catalog": {"type": "object", "additionalProperties": {"type": "object", "required": ["size", "label", "collider", "family"],
   "properties": {"size": {"$ref": "#/$defs/size3"}, "collider": {"type": "boolean"},
    "family": {"enum": ["furniture", "signage", "plant", "pantry", "sanitary", "ict", "recreation", "sport", "shell"]}}}},
  "fixtures": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/fixture"}},
  "activitySlots": {"type": "array", "items": {"type": "object", "required": ["id", "fixture", "floor", "room", "activity", "pos", "facing", "pose", "capacity"],
   "properties": {"activity": {"enum": ["desk", "coffee", "chat", "read", "stretch", "game", "billiards", "exercise", "rest", "walk"]},
    "pose": {"enum": ["sit", "stand"]}, "capacity": {"type": "integer", "minimum": 1, "maximum": 8}}}},
  "waypoints": {"type": "array", "items": {"type": "object", "required": ["id", "floor", "pos", "kind"], "properties": {"kind": {"enum": ["spawn", "safe", "patrol"]}}}},
  "actors": {"type": "array", "maxItems": 13, "items": {"type": "object", "required": ["id", "displayName", "role", "kind", "avatarAsset", "allowedPublicFields", "simulated"],
   "properties": {"kind": {"enum": ["player", "npc"]}, "simulated": {"const": true},
    "allowedPublicFields": {"type": "array", "items": {"enum": ["displayName", "role", "activityState"]}}}}},
  "ict": {"type": "object", "required": ["status", "domains", "outlets", "devices", "racks", "pathways", "poeClasses", "assumptions"]},
  "adjacency": {"type": "array"},
  "occupantLoadFactors": {"type": "object"},
  "assumptions": {"type": "array", "items": {"type": "object", "required": ["id", "topic", "text"]}}
 }
}
